# `make hashpw` 로 아래 두 값을 생성해 붙여넣으세요.
ARCHGRAB_SECRET_KEY=
ARCHGRAB_PASSWORD_HASH=

# HTTPS(Cloudflare Tunnel 등) 뒤에 두면 true 로 바꾸세요.
ARCHGRAB_COOKIE_SECURE=false

# 받은 파일 보관 시간(초). 기본 6시간.
ARCHGRAB_FILE_TTL_SECONDS=21600

# 동시 다운로드 수. 플랫폼 차단을 줄이려면 낮게 유지하세요.
ARCHGRAB_MAX_CONCURRENT_DOWNLOADS=2

# 인스타/X 차단이 심할 때만 사용. 예: socks5://127.0.0.1:1080
# ARCHGRAB_PROXY=
