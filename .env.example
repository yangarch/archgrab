# `make hashpw` (또는 서버에서 `make hashpw-docker`) 로 아래 두 값을 생성해
# 붙여넣으세요.
#
# ⚠ 이 파일의 값에는 `$` 를 넣지 마세요. docker compose 의 env_file 은 값 안의
#   `$이름` 을 셸 변수로 해석해 빈 문자열로 바꿉니다. 예전 해시 형식이
#   scrypt$n$r$p$... 였는데, 그 때문에 6필드가 4필드로 잘린 채 컨테이너에
#   도착해 올바른 비밀번호도 항상 거부됐습니다. 지금은 `:` 를 쓰므로 안전합니다.
#   프록시 URL 등에 `$` 가 들어간다면 `$$` 로 이스케이프해야 합니다.
ARCHGRAB_SECRET_KEY=
ARCHGRAB_PASSWORD_HASH=

# HTTPS(Cloudflare Tunnel 등) 뒤에 두면 true 로 바꾸세요.
ARCHGRAB_COOKIE_SECURE=false

# 받은 파일 보관 시간(초). 기본 6시간.
ARCHGRAB_FILE_TTL_SECONDS=21600

# 동시 다운로드 수. 플랫폼 차단을 줄이려면 낮게 유지하세요.
ARCHGRAB_MAX_CONCURRENT_DOWNLOADS=2

# 인스타/X 차단이 심할 때만 사용. 예: socks5://127.0.0.1:1080
# ARCHGRAB_PROXY=
