{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev-password)",
      "Read(./secrets/**)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./.dev-password)",
      "Edit(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/block-egress.py\"",
            "timeout": 10,
            "statusMessage": "유출 방지 검사"
          }
        ]
      }
    ]
  }
}
