# archgrab 리버스 프록시 예시 (nginx)
#
# 앱은 컨테이너의 127.0.0.1:8000 에만 묶여 있고(docker-compose.yml), 외부 노출은
# nginx 가 담당한다. 아래 세 가지가 이 앱에서 특히 중요하다:
#
#   1. proxy_buffering off — 진행률(SSE)과 큰 파일 전달을 막지 않는다.
#      앱은 SSE 응답에 `X-Accel-Buffering: no` 를 보내므로 nginx 가 그 경로만
#      자동으로 버퍼를 끄지만, 파일 다운로드까지 디스크 임시파일을 거치지 않게
#      여기서도 꺼둔다.
#   2. X-Forwarded-For — 로그인 레이트리밋이 이 헤더로 IP 를 본다. 없으면
#      모든 요청이 같은 IP 로 보여 한 사람의 실패가 전체를 막는다.
#   3. HTTPS + ARCHGRAB_COOKIE_SECURE=true 는 한 쌍이다. HTTP 로 서비스하면서
#      true 로 두면 세션 쿠키가 저장되지 않아 로그인이 무한 반복된다.

server {
    listen 80;
    server_name archgrab.example.com;          # ← 도메인으로 바꾸세요
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;                                  # nginx 1.25.1+ (이전 버전은 listen 443 ssl http2;)
    server_name archgrab.example.com;          # ← 도메인으로 바꾸세요

    ssl_certificate     /etc/letsencrypt/live/archgrab.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archgrab.example.com/privkey.pem;

    # 쿠키 파일 업로드용 (앱 상한은 512KB)
    client_max_body_size 2m;

    # 개인용 서비스라 검색엔진에 노출할 이유가 없다
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 진행률 스트림과 파일 전달을 버퍼링으로 막지 않는다
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;

        # SSE 연결은 오래 열려 있다 (앱이 15초마다 keep-alive 주석을 보낸다)
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
